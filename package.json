{
  "name": "idioma",
  "private": true,
  "version": "0.5.28",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "vite build",
    "build:web": "vite build --mode web",
    "preview": "vite preview",
    "preview:web": "vite preview --mode web",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cd src-tauri && cargo test",
    "test:content": "npm --prefix content-studio test",
    "test:all": "node scripts/run-all-tests.cjs",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "marked": "^12.0.2",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "happy-dom": "^20.10.5",
    "prettier": "^3.9.10",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
